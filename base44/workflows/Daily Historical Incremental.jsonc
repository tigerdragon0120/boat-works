{
  "name": "Daily Historical Incremental",
  "description": "\u672c\u756a\u30d0\u30c3\u30af\u30d5\u30a3\u30eb\u5b8c\u4e86\u5f8c\u3001\u6bce\u65e505:00\u306b\u524d\u65e5\u306e\u516c\u5f0f\u7d50\u679c\u304cHistoricalRaceResult\u306b\u5b58\u5728\u3059\u308b\u304b\u78ba\u8a8d\u3057\u3001\u672a\u767b\u9332\u306e\u5834\u306e\u307f\u5dee\u5206\u8ffd\u52a0\u3059\u308b\u65e5\u6b21incremental\u66f4\u65b0\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_historical_incremental",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "incremental_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "controlHistoricalBackfill",
            "args": {
              "action": "incremental"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u524d\u65e5\u5dee\u5206\u8ffd\u52a0",
            "description": "\u524d\u65e5\u306e\u672a\u767b\u9332\u30ec\u30fc\u30b9\u7d50\u679c\u309224\u5834\u30b9\u30ad\u30e3\u30f3\u3057\u3066\u88dc\u5b8c"
          }
        }
      }
    ]
  }
}