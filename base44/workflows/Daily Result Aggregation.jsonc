{
  "name": "Daily Result Aggregation",
  "description": "\u6bce\u65e523:50 JST\u3002\u307e\u305a\u5f53\u65e5\u5168\u5834\u306e\u7d50\u679c\u8a73\u7d30\u30fb\u7bc0\u9593\u30dd\u30a4\u30f3\u30c8\u5b8c\u6210\u3092\u78ba\u8a8d\u3057\u3001\u5b8c\u4e86\u5f8c\u3060\u3051\u7fcc\u65e5\u306e\u5168\u958b\u50ac\u5834\u3092\u5834\u5358\u4f4d\u306712R\u5168\u90e8\u53ce\u96c6\u3002\u30e2\u30fc\u30cb\u30f3\u30b0\u2192\u901a\u5e38\u2192\u30ca\u30a4\u30bf\u30fc\u306e\u9806\u3067\u5c55\u793a\u524d\u57fa\u6e96\u70b9\u3092\u4f5c\u308a\u3001\u305d\u306e\u5f8c\u306b\u521d\u3081\u3066\u7fcc\u65e5\u30a2\u30e9\u30fc\u30c8\u3092\u751f\u6210\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "50 23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_result_aggregation",
      "version": "3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "build_tomorrow_baseline": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runPreRaceBaselineCoordinator",
            "args": {
              "target_offset": 1,
              "require_source_collection": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u7fcc\u65e5\u5168\u5834\u53ce\u96c6\u2192\u5c55\u793a\u524d\u57fa\u6e96\u70b9\u2192\u30a2\u30e9\u30fc\u30c8",
            "description": "\u5f53\u65e5\u5168\u7d50\u679c\u30fb\u7bc0\u9593\u30dd\u30a4\u30f3\u30c8\u5b8c\u6210\u3092\u30b2\u30fc\u30c8\u306b\u3057\u3001\u7fcc\u65e5\u306f\u5834\u3054\u3068\u306b12R\u5168\u4ef6\u53d6\u5f97\u5f8c\u3060\u3051pre\u5206\u6790\u30fb\u30a2\u30e9\u30fc\u30c8\u958b\u59cb"
          }
        }
      }
    ]
  }
}