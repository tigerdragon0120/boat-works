{
  "name": "Daily Result Aggregation",
  "description": "v10\u591c\u9593\u7b2c3\u6bb5\u968e\u3002\u6bce\u65e523:50 JST\u306b\u7fcc\u65e5\u306e\u51fa\u8d70\u8868\u3092\u5168\u5834\u53d6\u5f97\u3057\u300123:35\u78ba\u5b9a\u6e08\u307f\u30b7\u30ea\u30fc\u30ba\u30dd\u30a4\u30f3\u30c8\u3092\u4f7f\u3063\u3066v10\u4e8b\u524d\u5206\u6790\u30fb\u30a2\u30e9\u30fc\u30c8\u9078\u51fa\u3092\u78ba\u5b9a\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "50 23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
