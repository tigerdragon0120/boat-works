{
  "name": "Race Integrity Watchdog",
  "description": "[\u505c\u6b62\u4e2d] \u5f53\u65e5\u30c7\u30fc\u30bf\u6574\u5408\u6027\u81ea\u5df1\u4fee\u5fa9\u3002\u7dca\u6025\u4fee\u5fa9\u6642\u306e\u307f\u7ba1\u7406\u8005\u304c\u624b\u52d5\u5b9f\u884c\u3002\u901a\u5e38\u6642\u306fRace Integrity Check(runRaceIntegrityCheck)\u306b\u7d71\u4e00\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2099-12-31T00:00:00Z",
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "race_integrity_watchdog",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "repair_today_integrity": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 0,
              "stage": "pre",
              "collect_only": true,
              "mode": "emergency_repair"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u5f53\u65e5\u30c7\u30fc\u30bf\u6574\u5408\u6027\u30c1\u30a7\u30c3\u30af\uff08\u7dca\u6025\u4fee\u5fa9\u7528\uff09",
            "description": "\u7dca\u6025\u4fee\u5fa9\u6642\u306e\u307f\u624b\u52d5\u5b9f\u884c\u3002\u901a\u5e38\u6642\u306fRace Integrity Check\u306b\u7d71\u4e00\u3002"
          }
        }
      }
    ]
  }
}