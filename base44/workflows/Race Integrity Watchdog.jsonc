{
  "name": "Race Integrity Watchdog",
  "description": "5分ごとに当日データの整合性を自己修復する。Race重複・孤児分析・Alert/学習重複・出走表欠損を修復し、予想の再生成は行わない。",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 0-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "race_integrity_watchdog",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "repair_today_integrity": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 0,
              "stage": "pre",
              "collect_only": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "当日データ整合性チェック",
            "description": "Race・RaceEntry・UichiAnalysis・Alert・学習原本の整合性を5分ごとに自己修復する"
          }
        }
      }
    ]
  }
}
