{
  "name": "Ready Race Analysis Worker",
  "description": "10\u5206\u3054\u3068\u306b\u5f53\u65e5\u5206\u306e6\u8247\u63c3\u3063\u305f\u672a\u5206\u6790\u30ec\u30fc\u30b9\u3092\u691c\u51fa\u3057\u3001v8 pre\u5206\u6790\u3092\u5c0f\u5206\u3051\u3067\u5b9f\u884c\u3059\u308b\u3002\u30c7\u30fc\u30bf\u53d6\u5f97\u51e6\u7406\u3068\u306f\u72ec\u7acb\u3057\u3066\u52d5\u304f\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 0-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
