{
  "name": "Historical Full Spec Backfill",
  "description": "\u904e\u53bb6\u304b\u6708\u306e\u7d50\u679c\u4e00\u89a7\u3060\u3051\u3067\u306a\u304f\u3001\u73fe\u5728\u306eBOAT WORKS\u4ed5\u69d8\u306b\u5408\u308f\u305b\u3066\u7d50\u679c\u8a73\u7d30\u30fb\u51686\u8247\u51fa\u8d70\u8868\u30fb\u30b7\u30ea\u30fc\u30ba\u6587\u8108\u30fb\u53d6\u5f97\u53ef\u80fd\u306a\u5c55\u793a\u60c5\u5831\u307e\u3067\u81ea\u52d5\u88dc\u5b8c\u3059\u308b\u3002\u76f4\u8fd1\u65e5\u4ed8\u304b\u3089\u512a\u5148\u3057\u3001\u516c\u5f0f\u30b5\u30a4\u30c8\u8ca0\u8377\u3092\u6291\u3048\u306630\u5206\u3054\u3068\u306b4\u958b\u50ac\u5834\u65e5\u305a\u3064\u9032\u3081\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
