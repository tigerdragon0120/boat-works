{
  "name": "Urgent Race Entry Repair Worker",
  "description": "\u5f53\u65e5\u306e\u7de0\u5207\u304c\u8fd1\u3044\u51fa\u8d70\u8868\u672a\u53d6\u5f97\u30ec\u30fc\u30b9\u30925\u5206\u3054\u3068\u306b\u6700\u512a\u5148\u3067\u81ea\u5df1\u4fee\u5fa9\u3057\u30016\u8247\u63c3\u3063\u305f\u3089\u5373v8\u5206\u6790\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "29 4 1 1 *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
