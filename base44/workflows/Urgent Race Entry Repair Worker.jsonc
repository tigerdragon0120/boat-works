{
  "name": "Urgent Race Entry Repair Worker",
  "description": "当日の締切が近い出走表未取得レースを5分ごとに最優先で自己修復し、6艇揃ったら即v8分析する。",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 0-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "urgent_race_entry_repair_worker",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "repair_urgent_today": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 0,
              "stage": "pre"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "締切近接レース緊急修復",
            "description": "締切90分以内の未取得レースを全場スキャンより先に取得し、即分析する"
          }
        }
      }
    ]
  }
}
