          },
          "then": "end",
          "x-base44": {
            "title": "\u904e\u53bb1\u53f7\u8247\u8a73\u7d30\u3092\u81ea\u52d5\u88dc\u5b8c",
            "description": "\u65b0\u3057\u3044\u65e5\u4ed8\u304b\u3089\u4e0d\u8db3\u8a73\u7d30\u3092\u6bce\u6642\u88dc\u5b8c"
