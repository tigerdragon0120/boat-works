{
  "name": "Hourly Detail Backfill",
  "description": "\u904e\u53bbRaceResult\u306e1\u53f7\u8247\u8a73\u7d30\u4e0d\u8db3\u5206\u3092\u6bce\u6642\u81ea\u52d5\u88dc\u5b8c\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "10 * * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "hourly_detail_backfill",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_backfill": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runBackgroundDetailBackfill",
            "args": {
