{
  "name": "Daily Overnight Analysis",
  "description": "毎日18時から23時30分まで30分ごとに翌日の全24場を確認し、出走表だけを先行収集する。今日の全場結果・詳細・節間ポイントが完成するまでは予想分析やアラート生成を行わない。",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 18-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_overnight_analysis",
      "version": "3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "collect_tomorrow_entries": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 1,
              "stage": "pre",
              "collect_only": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "翌日出走表の先行収集",
            "description": "翌日出走表を保存するだけ。分析・アラートは今日の全データと節間ポイント確定後まで待機"
          }
        }
      }
    ]
  }
}
