{
  "name": "Daily Overnight Analysis",
  "description": "\u6bce\u65e518\u6642\u304b\u308923\u664230\u5206\u307e\u306730\u5206\u3054\u3068\u306b\u7fcc\u65e5\u306e\u516824\u5834\u3092\u78ba\u8a8d\u3057\u3001\u51fa\u8d70\u8868\u304c\u65b0\u898f\u516c\u958b\u30fb\u66f4\u65b0\u3055\u308c\u305f\u30ec\u30fc\u30b9\u304b\u3089\u9806\u6b21v8\u4e8b\u524d\u5206\u6790\u3059\u308b\u3002\u5168\u5834\u304c\u63c3\u3046\u306e\u3092\u5f85\u305f\u306a\u3044\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 18-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_overnight_analysis",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_overnight": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 1,
              "stage": "pre"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u7fcc\u65e5\u51fa\u8d70\u8868\u76e3\u8996\u30fb\u5373\u5206\u6790",
            "description": "30\u5206\u3054\u3068\u306b\u65b0\u898f\u516c\u958b/\u66f4\u65b0\u691c\u77e5\u2192\u8a72\u5f53\u30ec\u30fc\u30b9\u3092\u5373v8\u5206\u6790"
          }
        }
      }
    ]
  }
}