{
  "name": "Daily Overnight Analysis",
  "description": "\u6bce\u65e518\u6642\u304b\u308923\u664230\u5206\u307e\u306730\u5206\u3054\u3068\u306b\u7fcc\u65e5\u306e\u516824\u5834\u3092\u78ba\u8a8d\u3057\u3001\u51fa\u8d70\u8868\u3060\u3051\u3092\u5148\u884c\u53ce\u96c6\u3059\u308b\u3002mode=pre_race_collection\u3067\u516c\u5f0f\u30b5\u30a4\u30c8\u304b\u3089\u7fcc\u65e5\u51fa\u8d70\u8868\u3092\u53d6\u5f97\u3002\u524d\u65e5\u5b8c\u6210\u30e2\u30c7\u30eb\u306e\u4e2d\u6838\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 18-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_overnight_analysis",
      "version": "3.0",
      "namespace": "base44"
    },
    "do": [
      {
        "collect_tomorrow_entries": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 1,
              "stage": "pre",
              "collect_only": true,
              "mode": "pre_race_collection"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u7fcc\u65e5\u51fa\u8d70\u8868\u306e\u5148\u884c\u53ce\u96c6",
            "description": "\u7fcc\u65e5\u51fa\u8d70\u8868\u3092\u4fdd\u5b58\u3059\u308b\u3060\u3051\u3002\u5206\u6790\u30fb\u30a2\u30e9\u30fc\u30c8\u306f\u4eca\u65e5\u306e\u5168\u30c7\u30fc\u30bf\u3068\u7bc0\u9593\u30dd\u30a4\u30f3\u30c8\u78ba\u5b9a\u5f8c\u307e\u3067\u5f85\u6a5f"
          }
        }
      }
    ]
  }
}