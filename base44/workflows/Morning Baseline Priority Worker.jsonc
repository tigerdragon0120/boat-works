{
  "name": "Morning Baseline Priority Worker",
  "description": "\u6bce\u65e55:00\u301c10:55 JST\u306b5\u5206\u3054\u3068\u306b\u5f53\u65e5\u5168\u5834\u53ce\u96c6\u3092\u518d\u78ba\u8a8d\u3002\u30e2\u30fc\u30cb\u30f3\u30b0\u5834\u306e\u7b2c1R\u524d\u306b\u5c55\u793a\u524d\u57fa\u6e96\u70b9\u3092\u5fc5\u305a\u4f5c\u308b\u3053\u3068\u3092\u6700\u512a\u5148\u3068\u3057\u3001\u901a\u5e38\u5834\u30fb\u30ca\u30a4\u30bf\u30fc\u5834\u3082\u4e26\u884c\u3057\u3066\u4e0d\u8db3\u5206\u3092\u57cb\u3081\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
