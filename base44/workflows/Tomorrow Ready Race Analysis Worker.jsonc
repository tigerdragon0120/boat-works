{
  "name": "Tomorrow Ready Race Analysis Worker",
  "description": "\u524d\u65e518\u6642\u304b\u308923\u664250\u5206\u307e\u306710\u5206\u3054\u3068\u306b\u7fcc\u65e5\u5206\u306e6\u8247\u63c3\u3063\u305f\u672a\u5206\u6790\u30ec\u30fc\u30b9\u3092\u691c\u51fa\u3057\u3001v8 pre\u5206\u6790\u3092\u5c0f\u5206\u3051\u3067\u5b9f\u884c\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 18-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tomorrow_ready_race_analysis_worker",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "analyze_tomorrow_ready": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runReadyRaceAnalysis",
            "args": {
              "target_offset": 1,
              "stage": "pre",
              "max_races": 40
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u7fcc\u65e5\u6e96\u5099\u6e08\u307f\u30ec\u30fc\u30b9\u5206\u6790",
            "description": "\u524d\u65e5\u591c\u30016\u8247\u63c3\u3063\u305f\u7fcc\u65e5\u30ec\u30fc\u30b9\u309210\u5206\u3054\u3068\u306bv8\u5206\u6790"
          }
        }
      }
    ]
  }
}