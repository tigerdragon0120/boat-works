{
  "name": "Tomorrow Ready Race Analysis Worker",
  "description": "\u7fcc\u65e5\u306e\u51fa\u8d70\u8868\u516c\u958b\u72b6\u6cc1\u309210\u5206\u3054\u3068\u306b\u78ba\u8a8d\u3057\u3066\u4fdd\u5b58\u3059\u308b\u3060\u3051\u306e\u53ce\u96c6\u30ef\u30fc\u30ab\u30fc\u3002\u4eca\u65e5\u306e\u5168\u30ec\u30fc\u30b9\u8a73\u7d30\u3068\u7bc0\u9593\u30dd\u30a4\u30f3\u30c8\u304c\u5b8c\u6210\u3059\u308b\u307e\u3067\u306f\u5206\u6790\u30fb\u30a2\u30e9\u30fc\u30c8\u751f\u6210\u3092\u3057\u306a\u3044\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 18-23 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "tomorrow_ready_race_collection_worker",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "collect_tomorrow_ready": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 1,
              "stage": "pre",
              "collect_only": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u7fcc\u65e5\u51fa\u8d70\u8868\u53ce\u96c6",
            "description": "6\u8247\u306e\u51fa\u8d70\u8868\u3092\u4fdd\u5b58\u3002\u30a2\u30e9\u30fc\u30c8\u5206\u6790\u306f\u4eca\u65e5\u306e\u30c7\u30fc\u30bf\u53ce\u96c6\u5b8c\u4e86\u5f8c\u306b\u5b9f\u884c"
          }
        }
      }
    ]
  }
}