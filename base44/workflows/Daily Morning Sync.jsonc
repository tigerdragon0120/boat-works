{
  "name": "Daily Morning Sync",
  "description": "毎日0時から10時59分まで5分ごとに当日の全24場を確認し、出走表の新規公開・更新を検知したレースから順次v8分析する。締切間近の欠損レースは最優先で自己修復する。",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 0-10 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_morning_sync",
      "version": "2.1",
      "namespace": "base44"
    },
    "do": [
      {
        "run_today_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 0,
              "stage": "pre"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "当日出走表監視・自己修復",
            "description": "5分ごとに新規公開/更新検知→締切間近の欠損を最優先修復→該当レースを即v8分析"
          }
        }
      }
    ]
  }
}
