{
  "name": "Daily Morning Sync",
  "description": "\u6bce\u65e50\u6642\u304b\u308910\u664230\u5206\u307e\u306730\u5206\u3054\u3068\u306b\u5f53\u65e5\u306e\u516824\u5834\u3092\u78ba\u8a8d\u3057\u3001\u51fa\u8d70\u8868\u306e\u65b0\u898f\u516c\u958b\u30fb\u66f4\u65b0\u3092\u691c\u77e5\u3057\u305f\u30ec\u30fc\u30b9\u304b\u3089\u9806\u6b21v8\u5206\u6790\u3059\u308b\u3002\u6b20\u640d\u30ec\u30fc\u30b9\u306f\u81ea\u5df1\u4fee\u5fa9\u3059\u308b\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/30 0-10 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_morning_sync",
      "version": "2.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_today_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 0,
              "stage": "pre"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u5f53\u65e5\u51fa\u8d70\u8868\u76e3\u8996\u30fb\u81ea\u5df1\u4fee\u5fa9",
            "description": "30\u5206\u3054\u3068\u306b\u65b0\u898f\u516c\u958b/\u66f4\u65b0\u691c\u77e5\u2192\u6b20\u640d\u4fee\u5fa9\u2192\u8a72\u5f53\u30ec\u30fc\u30b9\u3092\u5373v8\u5206\u6790"
          }
        }
      }
    ]
  }
}