{
  "name": "Daily Morning Sync",
  "description": "\u6bce\u671d6\u6642\u304b\u308910\u6642\u307e\u3067\u6bce\u6642\u3001\u672c\u65e5\u306e\u958b\u50ac\u5834\u4e00\u89a7\u3092\u516c\u5f0f\u304b\u3089\u518d\u78ba\u8a8d\u3057\u3001\u4e0d\u8db3Race\u30fb\u51fa\u8d70\u8868\u3092\u88dc\u5b8c\u3057\u3066pre\u5206\u6790\u307e\u3067\u4fdd\u5b58\u3059\u308b\u3002\u753b\u9762\u8868\u793a\u3068\u306f\u5b8c\u5168\u5206\u96e2\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6-10 * * *",
      "one_time_date": null,
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_morning_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_today_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runDailyOvernight",
            "args": {
              "target_offset": 0,
              "skip_aggregate": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u672c\u65e5\u5168\u5834\u540c\u671f",
            "description": "\u958b\u50ac\u5834\u518d\u78ba\u8a8d\u2192Race/\u51fa\u8d70\u8868\u88dc\u5b8c\u2192pre\u5206\u6790\u4fdd\u5b58"
          }
        }
      }
    ]
  }
}