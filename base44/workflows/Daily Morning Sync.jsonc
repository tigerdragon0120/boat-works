{
  "name": "Daily Morning Sync",
  "description": "[\u505c\u6b62\u4e2d] \u5f53\u65e5\u671d\u306e\u51fa\u8d70\u8868\u518d\u53d6\u5f97\u7528\u3002\u524d\u65e5\u5b8c\u6210\u30e2\u30c7\u30eb\u306e\u305f\u3081\u901a\u5e38\u6642\u306f\u4e0d\u8981\u3002\u7dca\u6025\u4fee\u5fa9\u6642\u306e\u307f\u7ba1\u7406\u8005\u304c\u624b\u52d5\u5b9f\u884c\u3002",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "one_time",
      "cron_expression": null,
      "one_time_date": "2099-12-31T00:00:00Z",
      "timezone": "Asia/Tokyo",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_morning_sync",
      "version": "2.1",
      "namespace": "base44"
    },
    "do": [
      {
        "run_today_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRaceDayIntegritySync",
            "args": {
              "target_offset": 0,
              "stage": "pre",
              "mode": "emergency_repair"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "\u5f53\u65e5\u51fa\u8d70\u8868\u7dca\u6025\u53d6\u5f97\uff08\u624b\u52d5\u5b9f\u884c\u7528\uff09",
            "description": "\u7dca\u6025\u4fee\u5fa9\u6642\u306e\u307f\u624b\u52d5\u5b9f\u884c\u3002\u901a\u5e38\u6642\u306f\u524d\u65e5\u5b8c\u6210\u6e08\u307f\u3002"
          }
        }
      }
    ]
  }
}