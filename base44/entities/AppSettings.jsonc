    },
    "reliability_a_threshold": {
      "type": "number",
      "description": "\u4fe1\u983c\u5ea6A\u306e\u6700\u4f4e\u30b5\u30f3\u30d7\u30eb\u6570"
    },
    "reliability_b_threshold": {
      "type": "number",
      "description": "\u4fe1\u983c\u5ea6B\u306e\u6700\u4f4e\u30b5\u30f3\u30d7\u30eb\u6570"
    },
    "reliability_c_threshold": {
      "type": "number",
      "description": "\u4fe1\u983c\u5ea6C\u306e\u6700\u4f4e\u30b5\u30f3\u30d7\u30eb\u6570"
    },
    "trust_weight_basic": {
      "type": "number",
      "description": "1\u53f7\u8247\u4fe1\u983c\u30b9\u30b3\u30a2: \u9078\u624b\u57fa\u672c\u529b\u306e\u6700\u5927\u70b9 (\u30c7\u30d5\u30a9\u30eb\u30c820)",
      "default": 20
    },
    "trust_weight_lane1": {
      "type": "number",
      "description": "1\u53f7\u8247\u4fe1\u983c\u30b9\u30b3\u30a2: 1\u30b3\u30fc\u30b9\u4fe1\u983c\u6027\u306e\u6700\u5927\u70b9 (\u30c7\u30d5\u30a9\u30eb\u30c820)",
      "default": 20
    },
    "trust_weight_venue": {
      "type": "number",
      "description": "1\u53f7\u8247\u4fe1\u983c\u30b9\u30b3\u30a2: \u5f53\u5730\u76f8\u6027\u306e\u6700\u5927\u70b9 (\u30c7\u30d5\u30a9\u30eb\u30c815)",
      "default": 15
    },
    "trust_weight_st": {
      "type": "number",
      "description": "1\u53f7\u8247\u4fe1\u983c\u30b9\u30b3\u30a2: ST\u8a55\u4fa1\u306e\u6700\u5927\u70b9 (\u30c7\u30d5\u30a9\u30eb\u30c810)",
      "default": 10
    },
    "trust_weight_motor": {
      "type": "number",
      "description": "1\u53f7\u8247\u4fe1\u983c\u30b9\u30b3\u30a2: \u30e2\u30fc\u30bf\u30fc\u8a55\u4fa1\u306e\u6700\u5927\u70b9 (\u30c7\u30d5\u30a9\u30eb\u30c810)",
      "default": 10
    },
    "trust_weight_weather": {
      "type": "number",
      "description": "1\u53f7\u8247\u4fe1\u983c\u30b9\u30b3\u30a2: \u5929\u5019\u9069\u6027\u306e\u6700\u5927\u70b9 (\u30c7\u30d5\u30a9\u30eb\u30c810\u30fb\u30c7\u30fc\u30bf\u4e0d\u8db3\u6642\u306f\u8a55\u4fa1\u5bfe\u8c61\u5916)",
      "default": 10
    },
    "trust_strong_threshold": {
      "type": "number",
      "description": "STRONG BUY\u306e\u4fe1\u983c\u30b9\u30b3\u30a2\u3057\u304d\u3044\u5024 (\u30c7\u30d5\u30a9\u30eb\u30c885)",
      "default": 85
    },
    "trust_buy_threshold": {
      "type": "number",
      "description": "BUY\u5019\u88dc\u306e\u4fe1\u983c\u30b9\u30b3\u30a2\u3057\u304d\u3044\u5024 (\u30c7\u30d5\u30a9\u30eb\u30c875)",
      "default": 75
    },
    "settings_version": {
      "type": "number",
      "description": "\u8a2d\u5b9a\u30d0\u30fc\u30b8\u30e7\u30f3\u3002\u5909\u66f4\u6642\u306b\u30a4\u30f3\u30af\u30ea\u30e1\u30f3\u30c8\u3067\u53e4\u3044\u5206\u6790\u7d50\u679c\u3092\u7121\u52b9\u5316",
      "default": 1
    },
    "notify_min_ev": {
      "type": "number",
      "description": "\u30d7\u30c3\u30b7\u30e5\u901a\u77e5\u3092\u9001\u308b\u6700\u4f4e\u671f\u5f85\u5024\u6307\u6570\uff08%\uff09\u3002\u3053\u308c\u672a\u6e80\u306eBUY\u306f\u901a\u77e5\u3057\u306a\u3044 (\u30c7\u30d5\u30a9\u30eb\u30c8110)",
      "default": 110
    },
    "notify_min_trust_score": {
      "type": "number",
      "description": "\u30d7\u30c3\u30b7\u30e5\u901a\u77e5\u3092\u9001\u308b\u6700\u4f4e1\u53f7\u8247\u4fe1\u983c\u30b9\u30b3\u30a2\u30020\u306a\u3089\u65e0\u6761\u4ef6 (\u30c7\u30d5\u30a9\u30eb\u30c80)",
      "default": 0
    },
    "notify_only_strong": {
      "type": "boolean",
      "description": "STRONG BUY\uff08\u4fe1\u983c\u30b9\u30b3\u30a2\u2265trust_strong_threshold\uff09\u306e\u307f\u901a\u77e5\u3059\u308b (\u30c7\u30d5\u30a9\u30eb\u30c8false)",
      "default": false
    },
    "notify_watch": {
      "type": "boolean",
      "description": "WATCH\u5224\u5b9a\u3082\u901a\u77e5\u3059\u308b (\u30c7\u30d5\u30a9\u30eb\u30c8false)",
      "default": false
    }
  },
  "required": []
}