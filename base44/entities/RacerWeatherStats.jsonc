{
  "name": "RacerWeatherStats",
  "type": "object",
  "properties": {
    "registration_number": {
      "type": "string"
    },
    "venue_code": {
      "type": "string"
    },
    "weather": {
      "type": "string",
      "description": "\u5929\u5019(\u6674/\u66c7/\u96e8 etc)"
    },
    "wind_speed_group": {
      "type": "string",
      "description": "\u98a8\u901f\u30b0\u30eb\u30fc\u30d7(0-1/2-3/4-5/6+)"
    },
    "wind_dir": {
      "type": "string",
      "description": "\u98a8\u5411"
    },
    "races": {
      "type": "number"
    },
    "wins": {
      "type": "number"
    },
    "win_rate": {
      "type": "number",
      "description": "1\u7740\u7387(0-1)"
    },
    "avg_st": {
      "type": "number"
    },
    "st_count": {
      "type": "number",
      "description": "ST\u96c6\u8a08\u30b5\u30f3\u30d7\u30eb\u6570(\u5185\u90e8\u7528)"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "stats_version": {
      "type": "number"
    }
  },
  "required": [
    "registration_number",
    "venue_code"
  ]
}