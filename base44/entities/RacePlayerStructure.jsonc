      "description": "\u3046\u3044\u3061\u9078\u624b\u914d\u7f6e\u6307\u6570 0-100"
    },
    "ura_uichi_player_structure_score": {
      "type": "number",
      "description": "\u88cf\u3046\u3044\u3061\u9078\u624b\u914d\u7f6e\u6307\u6570 0-100"
    },
    "boat_evaluations": {
      "type": "array",
      "items": {
        "type": "object"
