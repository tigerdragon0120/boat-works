      "type": "number"
    },
    "recent_durations": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "average_venue_duration_ms": {
      "type": "number"
    },
    "venue_days_per_hour": {
      "type": "number"
    },
    "races_per_hour": {
      "type": "number"
    },
    "racer_results_per_hour": {
      "type": "number"
    },
    "estimated_remaining_days": {
      "type": "number"
    },
    "estimated_completion_at": {
      "type": "string",
      "format": "date-time"
    },
    "worker_heartbeat": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "last_completed_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
