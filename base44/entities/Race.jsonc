{
  "name": "Race",
  "type": "object",
  "properties": {
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "race_name": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "event_name": {
      "type": "string"
    },
    "series_key": {
      "type": "string"
    },
    "series_start_date": {
      "type": "string",
      "format": "date"
    },
    "series_end_date": {
      "type": "string",
      "format": "date"
    },
    "series_total_days": {
      "type": "number"
    },
    "series_day": {
      "type": "number"
    },
    "is_final_day": {
      "type": "boolean"
    },
    "race_phase": {
      "type": "string",
      "enum": [
        "QUALIFYING",
        "GENERAL",
        "SEMIFINAL",
        "FINAL",
        "SELECTION",
        "DREAM",
        "OTHER"
      ]
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "morning",
        "day",
        "night"
      ]
    },
    "weather": {
      "type": "string"
    },
    "wind_dir": {
      "type": "string"
    },
    "wind_speed": {
      "type": "number"
    },
    "wave_height": {
      "type": "number"
    },
    "air_temperature": {
      "type": "number"
    },
    "water_temperature": {
      "type": "number"
    },
    "beforeinfo_fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "exhibition_ready": {
      "type": "boolean"
    },
    "scratched_boats": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "finished",
        "cancelled"
      ]
    },
    "result_trifecta": {
      "type": "string"
    },
    "is_uichi": {
      "type": "boolean"
    },
    "payout_trifecta": {
      "type": "number"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "official",
        "sample"
      ]
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "entries_fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "odds_fetched_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "race_date",
    "venue_code",
    "venue_name",
    "race_number"
  ]
}