{
  "name": "UichiLearningMetric",
  "type": "object",
  "properties": {
    "metric_key": {
      "type": "string"
    },
    "dimension": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "sample_count": {
      "type": "number"
    },
    "boat1_win_count": {
      "type": "number"
    },
    "boat1_win_rate": {
      "type": "number"
    },
    "main_hit_count": {
      "type": "number"
    },
    "main_hit_rate": {
      "type": "number"
    },
    "ura_hit_count": {
      "type": "number"
    },
    "ura_hit_rate": {
      "type": "number"
    },
    "recommended_hit_count": {
      "type": "number"
    },
    "recommended_hit_rate": {
      "type": "number"
    },
    "reliable": {
      "type": "boolean"
    },
    "min_sample": {
      "type": "number"
    },
    "analysis_version": {
      "type": "string"
    },
    "last_sample_date": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "new_main_hit_count": {
      "type": "number"
    },
    "new_main_hit_rate": {
      "type": "number"
    },
    "new_ura_hit_count": {
      "type": "number"
    },
    "new_ura_hit_rate": {
      "type": "number"
    },
    "false_skip_count": {
      "type": "number"
    },
    "false_skip_rate": {
      "type": "number"
    },
    "false_watch_count": {
      "type": "number"
    },
    "false_watch_rate": {
      "type": "number"
    },
    "candidate_pattern": {
      "type": "string",
      "enum": [
        "MAIN",
        "URA",
        "NEW_MAIN",
        "NEW_URA",
        "NONE"
      ]
    },
    "candidate_lift": {
      "type": "number"
    },
    "candidate_status": {
      "type": "string",
      "enum": [
        "LEARNING",
        "CANDIDATE",
        "RELIABLE"
      ]
    }
  },
  "required": [
    "metric_key",
    "dimension",
    "value"
  ]
}