{
  "name": "HistoricalRaceResult",
  "type": "object",
  "properties": {
    "race_natural_key": {
      "type": "string",
      "description": "race_date_venuecode_racenum (\u4f8b: 2023-05-01_01_01)"
    },
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "race_number": {
      "type": "number"
    },
    "series_day_number": {
      "type": "number",
      "description": "\u958b\u50ac\u4f55\u65e5\u76ee"
    },
    "race_name": {
      "type": "string"
    },
    "race_grade": {
      "type": "string",
      "description": "SG/G1/G2/G3/GENERAL"
    },
    "series_title": {
      "type": "string"
    },
    "deadline_time": {
      "type": "string",
      "format": "date-time"
    },
    "weather": {
      "type": "string"
    },
    "air_temperature": {
      "type": "number"
    },
    "water_temperature": {
      "type": "number"
    },
    "wind_direction": {
      "type": "string"
    },
    "wind_speed": {
      "type": "number"
    },
    "wave_height": {
      "type": "number"
    },
    "winning_method": {
      "type": "string",
      "description": "\u9003\u3052/\u5dee\u3057/\u307e\u304f\u308a/\u307e\u304f\u308a\u5dee\u3057/\u629c\u304d/\u6075\u307e\u308c"
    },
    "first_place_boat": {
      "type": "number"
    },
    "second_place_boat": {
      "type": "number"
    },
    "third_place_boat": {
      "type": "number"
    },
    "trifecta_result": {
      "type": "string",
      "description": "3\u9023\u5358 (\u4f8b: 1-2-3)"
    },
    "trifecta_payout": {
      "type": "number"
    },
    "race_time_1_seconds": {
      "type": "number"
    },
    "race_time_2_seconds": {
      "type": "number"
    },
    "race_time_3_seconds": {
      "type": "number"
    },
    "margin_1_2_seconds": {
      "type": "number"
    },
    "margin_1_3_seconds": {
      "type": "number"
    },
    "race_status": {
      "type": "string",
      "enum": [
        "CONFIRMED",
        "CANCELLED",
        "PENDING"
      ]
    },
    "data_source": {
      "type": "string",
      "enum": [
        "official"
      ]
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "race_natural_key"
  ]
}