{
  "name": "VenueDayReadiness",
  "type": "object",
  "properties": {
    "race_date": {
      "type": "string",
      "format": "date"
    },
    "venue_code": {
      "type": "string"
    },
    "venue_name": {
      "type": "string"
    },
    "time_slot": {
      "type": "string",
      "enum": [
        "morning",
        "day",
        "night"
      ]
    },
    "first_deadline": {
      "type": "string",
      "format": "date-time"
    },
    "expected_races": {
      "type": "number"
    },
    "races_collected": {
      "type": "number"
    },
    "complete_entry_races": {
      "type": "number"
    },
    "core_complete_races": {
      "type": "number"
    },
    "series_points_ready": {
      "type": "boolean"
    },
    "racer_evaluations_ready": {
      "type": "boolean",
      "description": "\u53c2\u52a0\u9078\u624b\u5168\u54e1\u306e\u9078\u624b\u8a55\u4fa1(6m/1y/3y)\u304c\u751f\u6210\u6e08\u307f"
    },
    "racer_evaluations_count": {
      "type": "number",
      "description": "\u8a55\u4fa1\u6e08\u307f\u9078\u624b\u6570"
    },
    "racer_evaluations_total": {
      "type": "number",
      "description": "\u53c2\u52a0\u9078\u624b\u7dcf\u6570"
    },
    "player_structures_ready": {
      "type": "boolean",
      "description": "\u5168R\u306e\u3046\u3044\u3061/\u88cf\u3046\u3044\u3061\u9078\u624b\u914d\u7f6e\u6307\u6570\u304c\u751f\u6210\u6e08\u307f"
    },
    "player_structures_count": {
      "type": "number",
      "description": "\u9078\u624b\u914d\u7f6e\u6307\u6570\u751f\u6210\u6e08\u307fR\u6570"
    },
    "pre_alerts_ready": {
      "type": "boolean",
      "description": "\u5168R\u306e\u7fcc\u65e5\u4e8b\u524d\u30a2\u30e9\u30fc\u30c8(pre\u5206\u6790)\u304c\u751f\u6210\u6e08\u307f"
    },
    "pre_alerts_count": {
      "type": "number",
      "description": "\u4e8b\u524d\u30a2\u30e9\u30fc\u30c8\u751f\u6210\u6e08\u307fR\u6570"
    },
    "pre_race_ready": {
      "type": "boolean",
      "description": "7\u3064\u306e\u4e8b\u524d\u5de5\u7a0b(\u51fa\u8d70\u8868/\u57fa\u672c\u60c5\u5831/\u7bc0\u9593P/\u9078\u624b\u8a55\u4fa1/\u3046\u3044\u3061/\u88cf\u3046\u3044\u3061/\u4e8b\u524d\u30a2\u30e9\u30fc\u30c8)\u3059\u3079\u3066\u5b8c\u4e86"
    },
    "pre_race_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "exhibition_ready_races": {
      "type": "number",
      "description": "\u5c55\u793a\u30c7\u30fc\u30bf\u53d6\u5f97\u6e08\u307fR\u6570(\u5f53\u65e5)"
    },
    "odds_ready_races": {
      "type": "number",
      "description": "\u76f4\u524d\u30aa\u30c3\u30ba\u53d6\u5f97\u6e08\u307fR\u6570(\u5f53\u65e5)"
    },
    "final_judgment_races": {
      "type": "number",
      "description": "\u6700\u7d42\u5224\u5b9a\u6e08\u307fR\u6570(\u5f53\u65e5)"
    },
    "full_complete": {
      "type": "boolean",
      "description": "\u5c55\u793a/\u76f4\u524d\u30aa\u30c3\u30ba/\u6700\u7d42\u5224\u5b9a\u3059\u3079\u3066\u5b8c\u4e86(\u5f53\u65e5\u7528)"
    },
    "collection_status": {
      "type": "string",
      "enum": [
        "WAITING",
        "PRE_RACE_COMPLETE",
        "COMPLETE",
        "BASELINE_CAPTURED",
        "LATE_BASELINE"
      ]
    },
    "collection_completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "baseline_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "missing_races": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "race_date",
    "venue_code"
  ]
}