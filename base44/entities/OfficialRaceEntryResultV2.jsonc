      "type": "number"
    },
    "registration_number": {
      "type": "string"
    },
    "racer_name": {
      "type": "string"
    },
    "finish_order": {
      "type": "number",
      "description": "\u7740\u9806(1-6)"
    },
    "finish_status": {
      "type": "string",
      "enum": [
